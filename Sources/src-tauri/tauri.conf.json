{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TANREN",
  "version": "1.0.1",
  "identifier": "app.tanren.desktop",
  "build": {
    "beforeDevCommand": "npm run web:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run sidecar:sync && npm run build",
    "frontendDist": "../../Results/web-dist"
  },
  "app": {
    "windows": [
      {
        "title": "TANREN 鍛錬",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/app.tanren.desktop/audio/**/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "../public/tanren.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "../public/tanren.ico"
      }
    }
  }
}
